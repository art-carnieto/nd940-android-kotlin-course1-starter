<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorMainLogoBackground">

    <TextView
            android:id="@+id/instructionsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/onboarding_margin_horizontal"
            android:layout_marginTop="@dimen/onboarding_margin_vertical"
            android:layout_marginEnd="@dimen/onboarding_margin_horizontal"
            android:layout_marginBottom="@dimen/onboarding_margin_vertical"
            android:ellipsize="marquee"
            android:fontFamily="cursive"
            android:gravity="center_horizontal"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:text="@string/instructions_title"
            android:textIsSelectable="true"
            android:textSize="38sp"
            android:textStyle="bold|italic" />

    <VideoView
            android:id="@+id/instructionsVideo"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginStart="@dimen/onboarding_margin_horizontal"
            android:layout_marginEnd="@dimen/onboarding_margin_horizontal"
            android:layout_marginBottom="@dimen/onboarding_margin_vertical"
            android:visibility="visible" /> <!-- TODO: insert here video and make it visible -->

    <TextView
            android:id="@+id/instructionsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/onboarding_margin_horizontal"
            android:layout_marginEnd="@dimen/onboarding_margin_horizontal"
            android:layout_marginBottom="@dimen/onboarding_margin_vertical"
            android:scrollbars="vertical"
            android:text="@string/instructions_text"
            android:textColor="@color/design_default_color_on_secondary"
            android:textSize="14sp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/instructionsNextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginStart="@dimen/onboarding_margin_horizontal"
            android:layout_marginTop="@dimen/onboarding_margin_vertical"
            android:layout_marginEnd="@dimen/onboarding_margin_horizontal"
            android:layout_marginBottom="@dimen/onboarding_margin_vertical"
            android:clickable="true"
            android:focusable="true"
            app:backgroundTint="@color/colorActionButton"
            app:srcCompat="@android:drawable/ic_media_play" />

</LinearLayout>