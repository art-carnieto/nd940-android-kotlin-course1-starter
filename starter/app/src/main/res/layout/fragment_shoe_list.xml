<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">
    
    <data>
        <variable
                name="viewModel"
                type="com.udacity.shoestore.ui.ShoeListViewModel" />
        <variable
                name="fragment"
                type="com.udacity.shoestore.ui.ShoeListFragment" />
    </data>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <ScrollView
                android:id="@+id/shoeListScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/colorMainLogoBackground"
                android:orientation="vertical">

            <LinearLayout
                    android:id="@+id/shoeList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/shoeList_scroll_padding_horizontal"
                    android:layout_marginEnd="@dimen/shoeList_scroll_padding_horizontal"
                    android:paddingBottom="@dimen/shoeList_scroll_padding_vertical"
                    android:orientation="vertical">

                <TextView
                        android:id="@+id/shoeListTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:ellipsize="marquee"
                        android:fontFamily="cursive"
                        android:gravity="center_horizontal"
                        android:paddingStart="@dimen/shoeList_scroll_padding_horizontal"
                        android:paddingEnd="@dimen/shoeList_scroll_padding_horizontal"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:text="@string/shoeList_title"
                        android:textIsSelectable="true"
                        android:textSize="38sp"
                        android:textStyle="bold|italic" />
            </LinearLayout> <!-- shoeList -->
        </ScrollView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/addNewShoeBtn"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="end"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="-80dp"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_add"
                app:srcCompat="@drawable/ic_add"
                android:backgroundTint="@color/colorActionButton"
                android:contentDescription="@string/add_shoe_button_content_description" />
    </LinearLayout>
</layout>