<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/shoeListScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorMainLogoBackground"
        android:orientation="vertical"
        android:paddingTop="@dimen/shoeList_scroll_padding_vertical"
        android:paddingBottom="@dimen/shoeList_scroll_padding_vertical">

    <LinearLayout
            android:id="@+id/shoeList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/shoeList_scroll_padding_horizontal"
            android:layout_marginEnd="@dimen/shoeList_scroll_padding_horizontal"
            android:orientation="vertical">

        <TextView
                android:id="@+id/shoeListTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:ellipsize="marquee"
                android:fontFamily="cursive"
                android:gravity="center_horizontal"
                android:paddingStart="@dimen/shoeList_scroll_padding_horizontal"
                android:paddingEnd="@dimen/shoeList_scroll_padding_horizontal"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:text="@string/shoeList_title"
                android:textIsSelectable="true"
                android:textSize="38sp"
                android:textStyle="bold|italic" />

        <LinearLayout
                android:id="@+id/shoeItem"
                android:layout_width="match_parent"
                android:layout_height="@dimen/shoeList_shoeItem_item_height"
                android:layout_marginBottom="@dimen/shoeList_shoeItem_margin_bottom"
                android:background="@android:drawable/bottom_bar"
                android:orientation="horizontal">

            <ImageView
                    android:id="@+id/shoeThumbnail"
                    android:layout_width="@dimen/shoeList_shoeItem_item_img_width"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:srcCompat="@android:drawable/ic_menu_gallery" />

            <TextView
                    android:id="@+id/shoeName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="20"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:text="TextView" />

        </LinearLayout>

        <LinearLayout
                android:id="@+id/shoeItem2"
