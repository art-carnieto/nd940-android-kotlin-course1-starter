<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/shoeList_shoeItem_item_height"
    android:layout_marginBottom="@dimen/shoeList_shoeItem_margin_bottom"
    android:background="@android:drawable/bottom_bar"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/shoeThumbnail"
        android:layout_width="@dimen/shoeList_shoeItem_item_img_width"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/shoeList_shoeItem_item_img_start_padding"
        app:srcCompat="@drawable/ic_launcher_foreground"
        android:contentDescription="@string/shoe_image_placeholder_content_description" />

    <TextView
        android:id="@+id/shoeName"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="20"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/shoe_name_placeholder" />

    <Button
        android:id="@+id/shoeDetailsBtn"
        android:layout_width="@dimen/shoeList_shoeItem_btn_size"
        android:layout_height="@dimen/shoeList_shoeItem_btn_size"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="@dimen/shoeList_scroll_padding_horizontal"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="0dp"
        android:paddingEnd="@dimen/shoeList_scroll_padding_horizontal"
        android:background="@drawable/baseline_navigate_next_24" />

</LinearLayout>
